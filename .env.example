# 設定名と非機密の例だけを示す。実値は Git 外の worker/.dev.vars / shell環境へ置く。
DATA_BACKEND=supabase
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_example
SUPABASE_REPORT_ASSETS_BUCKET=report-assets
# 32文字以上のランダム値をworker/.dev.varsだけに設定する。実値はGitへ入れない。
RATE_LIMIT_IP_PEPPER=replace-with-32-plus-random-characters

# KV移行CLIの --execute 専用。access tokenはチャットやGitへ貼らない。
SUPABASE_LOCAL_URL=http://127.0.0.1:54321
# ローカル Supabase の anon key。既定値のままでも動くので、差し替えたいときだけ設定する
# （scripts/lib/local-stack.mjs・D-20260825-44。名前がここに無く、次の人が探せなかった）
SUPABASE_LOCAL_ANON_KEY=replace-with-local-anon-key
SUPABASE_ACCESS_TOKEN=replace-with-admin-user-access-token
MIGRATION_SHOP_ID=00000000-0000-0000-0000-000000000000
