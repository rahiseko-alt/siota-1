{
  "name": "trimmer-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-dist.mjs",
    "check": "node scripts/guard/run.mjs && node scripts/guard/isolation.mjs src && node scripts/guard/isolation.mjs dist && node scripts/src-dist-drift-guard.mjs . && node scripts/design-isolation-guard.mjs . && node scripts/guard/delete-order.mjs && node scripts/guard/ui-script-format.mjs && node scripts/guard/verify-inventory.mjs && node scripts/guard/key-parity.mjs",
    "test": "npm run test:unit && npm run test:schema && npm run test:migration && npm run test:backend && npm run test:sql",
    "test:unit": "node --test test/worker-unit.test.mjs test/magazine-view.test.mjs test/ui-body-marking.test.mjs test/ui-extract-report.test.mjs",
    "test:backend": "node --test test/backend-import.test.mjs test/supabase-auth.test.mjs test/local-stack-endpoint.test.mjs",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "verify:stack": "node scripts/verify-stack.mjs",
    "verify:portal": "node scripts/build-dist.mjs && node scripts/verify-portal.mjs",
    "verify:edit": "node scripts/build-dist.mjs && node scripts/verify-edit.mjs",
    "verify:xss": "node scripts/build-dist.mjs && node scripts/verify-xss.mjs",
    "verify:roundtrip": "node scripts/build-dist.mjs && node scripts/verify-report-roundtrip.mjs",
    "verify:empty": "node scripts/build-dist.mjs && node scripts/verify-empty-pet.mjs",
    "verify:screens": "node scripts/build-dist.mjs && node scripts/verify-screens.mjs",
    "test:migration": "node --test test/kv-migration.test.mjs",
    "test:sql": "node scripts/guard/sql-verified.mjs",
    "walk": "node scripts/build-dist.mjs && node scripts/walk-human.mjs",
    "test:schema": "node --test test/supabase-schema.test.mjs test/supabase-storage.test.mjs test/supabase-store.test.mjs",
    "serve": "node scripts/serve-ui.mjs",
    "guard": "node scripts/guard/run.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.6",
    "qrcode": "1.5.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "playwright": "1.59.1",
    "supabase": "2.109.1",
    "wrangler": "4.92.0"
  }
}
