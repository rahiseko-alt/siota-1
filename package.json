{
  "name": "trimmer-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-dist.mjs",
    "check": "node scripts/src-dist-drift-guard.mjs . && node scripts/design-isolation-guard.mjs .",
    "preview": "node scripts/build-dist.mjs && npx wrangler dev --config worker/wrangler.toml",
    "preview:supabase": "npm run build && npx wrangler dev --config worker/wrangler.supabase.toml",
    "test": "npm run test:unit && npm run test:supabase:static && npm run test:migration",
    "test:unit": "node --test test/worker-unit.test.mjs",
    "verify:m6": "node scripts/build-dist.mjs && node scripts/verify-m6.mjs",
    "verify:roundtrip": "node scripts/build-dist.mjs && node scripts/verify-report-roundtrip.mjs",
    "verify:empty": "node scripts/build-dist.mjs && node scripts/verify-empty-pet.mjs",
    "verify:xss": "node scripts/build-dist.mjs && node scripts/verify-xss.mjs",
    "verify:portal": "node scripts/build-dist.mjs && node scripts/verify-portal.mjs",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "verify:all": "node scripts/build-dist.mjs && node scripts/verify-m6.mjs && node scripts/verify-report-roundtrip.mjs && node scripts/verify-invitation.mjs && node scripts/verify-draft.mjs && node scripts/verify-empty-pet.mjs && node scripts/verify-xss.mjs && node scripts/verify-portal.mjs",
    "test:supabase:static": "node --test test/supabase-schema.test.mjs test/supabase-storage.test.mjs test/supabase-store.test.mjs test/supabase-auth.test.mjs",
    "test:supabase": "supabase test db",
    "test:migration": "node --test test/kv-migration.test.mjs",
    "verify:invitation": "node scripts/build-dist.mjs && node scripts/verify-invitation.mjs",
    "verify:draft": "node scripts/build-dist.mjs && node scripts/verify-draft.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.6",
    "qrcode": "1.5.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "playwright": "1.59.1",
    "supabase": "2.109.1",
    "wrangler": "4.92.0"
  }
}
